{
  "openapi": "3.1.0",
  "info": {
    "title": "Money Transfer Management API",
    "version": "1.0.0",
    "description": "Versioned JSON API for the existing money-transfer application. Except for login, all routes require a Sanctum bearer token. Monetary values are decimal strings with two fractional digits; exchange rates use eight fractional digits. Paginated lists accept `page` and `per_page` (maximum 100). Validation errors use Laravel's 422 JSON response; domain conflicts use an `error.code` value. Financial writes marked with `Idempotency-Key` replay the first saved response for the same user and payload, and return 409 if that key is reused for a different payload."
  },
  "servers": [{ "url": "/api/v1", "description": "API version 1" }],
  "tags": [
    { "name": "Authentication" }, { "name": "Transfers" }, { "name": "Dashboard and rates" },
    { "name": "Capital" }, { "name": "Users" }
  ],
  "security": [{ "sanctumBearer": [] }],
  "paths": {
    "/auth/login": { "post": { "tags": ["Authentication"], "summary": "Issue a bearer token", "security": [], "requestBody": { "$ref": "#/components/requestBodies/Login" }, "responses": { "201": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/auth/logout": { "post": { "tags": ["Authentication"], "summary": "Revoke the current token", "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/me": { "get": { "tags": ["Authentication"], "summary": "Return the authenticated user's safe profile", "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" } } } },

    "/transfers": {
      "get": { "tags": ["Transfers"], "summary": "List transfers", "parameters": [
        { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" },
        { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "completed", "cancelled"] } },
        { "name": "payment_status", "in": "query", "schema": { "type": "string", "enum": ["unpaid", "partially_paid", "paid"] } },
        { "name": "reference", "in": "query", "schema": { "type": "string", "maxLength": 100 } },
        { "name": "created_from", "in": "query", "schema": { "type": "string", "format": "date" } },
        { "name": "created_to", "in": "query", "schema": { "type": "string", "format": "date" } }
      ], "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } },
      "post": { "tags": ["Transfers"], "summary": "Create a transfer and optionally record an initial payment", "requestBody": { "$ref": "#/components/requestBodies/TransferMutation" }, "responses": { "201": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/transfers/calculate": { "post": { "tags": ["Transfers"], "summary": "Calculate a transfer quote", "requestBody": { "$ref": "#/components/requestBodies/TransferCalculation" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/transfers/{transfer}": {
      "parameters": [{ "$ref": "#/components/parameters/TransferId" }],
      "get": { "tags": ["Transfers"], "summary": "Read transfer details and payment history", "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } },
      "patch": { "tags": ["Transfers"], "summary": "Update a pending transfer", "requestBody": { "$ref": "#/components/requestBodies/TransferMutation" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/transfers/{transfer}/payments": { "parameters": [{ "$ref": "#/components/parameters/TransferId" }], "post": { "tags": ["Transfers"], "summary": "Record a customer installment", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/Payment" }, "responses": { "201": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/transfers/{transfer}/execute": { "parameters": [{ "$ref": "#/components/parameters/TransferId" }], "post": { "tags": ["Transfers"], "summary": "Upload proof and execute a pending transfer", "requestBody": { "$ref": "#/components/requestBodies/Proof" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/transfers/{transfer}/cancel": { "parameters": [{ "$ref": "#/components/parameters/TransferId" }], "post": { "tags": ["Transfers"], "summary": "Cancel an eligible pending transfer", "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/transfers/{transfer}/force-cancel": { "parameters": [{ "$ref": "#/components/parameters/TransferId" }], "post": { "tags": ["Transfers"], "summary": "Admin reversal of a completed transfer", "requestBody": { "$ref": "#/components/requestBodies/ForceCancel" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },

    "/dashboard/summary": { "get": { "tags": ["Dashboard and rates"], "summary": "Read authorized financial totals and counts", "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/exchange-rates": { "get": { "tags": ["Dashboard and rates"], "summary": "List currency exchange rates", "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/exchange-rates/{currency}": { "parameters": [{ "name": "currency", "in": "path", "required": true, "schema": { "type": "string", "enum": ["aed", "usd", "ils"] } }], "put": { "tags": ["Dashboard and rates"], "summary": "Update a rate (executor or admin)", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["rate_to_usd"], "properties": { "rate_to_usd": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,8})?$", "description": "Positive rate, up to eight decimal places." } } } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },

    "/capital-accounts": {
      "get": { "tags": ["Capital"], "summary": "List accounts visible to the authenticated role", "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }], "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } },
      "post": { "tags": ["Capital"], "summary": "Create an account and audit its opening balance", "requestBody": { "$ref": "#/components/requestBodies/CapitalAccountCreate" }, "responses": { "201": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/capital-accounts/{account}": { "parameters": [{ "name": "account", "in": "path", "required": true, "schema": { "type": "integer" } }], "patch": { "tags": ["Capital"], "summary": "Update account name, notes, or active status", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string", "maxLength": 255 }, "is_active": { "type": "boolean" }, "notes": { "type": ["string", "null"], "maxLength": 255 } } } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/capital-accounts/{account}/adjustments": { "parameters": [{ "name": "account", "in": "path", "required": true, "schema": { "type": "integer" } }, { "$ref": "#/components/parameters/IdempotencyKey" }], "post": { "tags": ["Capital"], "summary": "Record a manual balance adjustment (requires Idempotency-Key)", "requestBody": { "$ref": "#/components/requestBodies/Adjustment" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/capital-accounts/{account}/profit-withdrawals": { "parameters": [{ "name": "account", "in": "path", "required": true, "schema": { "type": "integer" } }, { "$ref": "#/components/parameters/IdempotencyKey" }], "post": { "tags": ["Capital"], "summary": "Withdraw from an eligible profit account (requires Idempotency-Key)", "requestBody": { "$ref": "#/components/requestBodies/Withdrawal" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/capital-transfers/preview": { "post": { "tags": ["Capital"], "summary": "Calculate capital transfer amounts without posting ledger entries", "requestBody": { "$ref": "#/components/requestBodies/CapitalTransfer" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/capital-transfers": { "get": { "tags": ["Capital"], "summary": "List capital transfer history", "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }], "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } }, "post": { "tags": ["Capital"], "summary": "Execute a capital transfer (requires Idempotency-Key)", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/CapitalTransfer" }, "responses": { "201": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/capital-transactions": { "get": { "tags": ["Capital"], "summary": "Admin-only paginated ledger", "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }, { "name": "account_id", "in": "query", "schema": { "type": "integer" } }, { "name": "type", "in": "query", "schema": { "type": "string" } }, { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" } }, { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" } }], "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },

    "/users": { "get": { "tags": ["Users"], "summary": "Admin-only paginated user list", "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }], "responses": { "200": { "$ref": "#/components/responses/PaginatedSuccess" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } }, "post": { "tags": ["Users"], "summary": "Create a user", "requestBody": { "$ref": "#/components/requestBodies/UserCreate" }, "responses": { "201": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/users/{user}": { "parameters": [{ "name": "user", "in": "path", "required": true, "schema": { "type": "integer" } }], "get": { "tags": ["Users"], "summary": "Read a safe user profile", "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }, "patch": { "tags": ["Users"], "summary": "Update permitted profile, role, or active fields", "requestBody": { "$ref": "#/components/requestBodies/UserUpdate" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } }, "delete": { "tags": ["Users"], "summary": "Delete a user if integrity rules allow it; self-deletion is blocked", "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } },
    "/users/{user}/password": { "parameters": [{ "name": "user", "in": "path", "required": true, "schema": { "type": "integer" } }], "put": { "tags": ["Users"], "summary": "Set a user's password and revoke their existing API tokens", "requestBody": { "$ref": "#/components/requestBodies/Password" }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/ValidationError" } } } }
  },
  "components": {
    "securitySchemes": { "sanctumBearer": { "type": "http", "scheme": "bearer", "bearerFormat": "Sanctum personal access token" } },
    "parameters": {
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "PerPage": { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "maxLength": 255 } },
      "TransferId": { "name": "transfer", "in": "path", "required": true, "schema": { "type": "integer" } }
    },
    "requestBodies": {
      "Login": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["email", "password", "device_name"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string" }, "device_name": { "type": "string", "maxLength": 100 } } } } } },
      "TransferCalculation": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransferCalculation" } } } },
      "TransferMutation": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransferMutation" } } } },
      "Payment": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["amount"], "properties": { "amount": { "$ref": "#/components/schemas/Money" }, "notes": { "type": ["string", "null"], "maxLength": 255 } } } } } },
      "Proof": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["proof"], "properties": { "proof": { "type": "string", "format": "binary", "description": "JPG, JPEG, PNG, or PDF; maximum 2 MiB." } } } } } },
      "ForceCancel": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["password"], "properties": { "password": { "type": "string" }, "notes": { "type": ["string", "null"], "maxLength": 255 } } } } } },
      "CapitalAccountCreate": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name", "branch", "currency", "account_type"], "properties": { "name": { "type": "string", "maxLength": 255 }, "branch": { "$ref": "#/components/schemas/Branch" }, "currency": { "$ref": "#/components/schemas/Currency" }, "account_type": { "$ref": "#/components/schemas/CapitalAccountType" }, "opening_balance": { "$ref": "#/components/schemas/Money" }, "is_active": { "type": "boolean", "default": true }, "notes": { "type": ["string", "null"] } } } } } },
      "Adjustment": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["direction", "amount", "notes"], "properties": { "direction": { "type": "string", "enum": ["in", "out"] }, "amount": { "$ref": "#/components/schemas/Money" }, "notes": { "type": "string", "maxLength": 255 } } } } } },
      "Withdrawal": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["amount"], "properties": { "amount": { "$ref": "#/components/schemas/Money" }, "notes": { "type": ["string", "null"], "maxLength": 255 } } } } } },
      "CapitalTransfer": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["from_account_id", "to_account_id", "source_amount", "transfer_cost"], "properties": { "from_account_id": { "type": "integer" }, "to_account_id": { "type": "integer" }, "source_amount": { "$ref": "#/components/schemas/Money" }, "transfer_cost": { "$ref": "#/components/schemas/Money" }, "notes": { "type": ["string", "null"], "maxLength": 255 } } } } } },
      "UserCreate": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name", "email", "role", "password", "password_confirmation"], "properties": { "name": { "type": "string" }, "email": { "type": "string", "format": "email" }, "role": { "$ref": "#/components/schemas/UserRole" }, "password": { "type": "string", "minLength": 8 }, "password_confirmation": { "type": "string" }, "timezone": { "type": ["string", "null"] } } } } } },
      "UserUpdate": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "email": { "type": "string", "format": "email" }, "role": { "$ref": "#/components/schemas/UserRole" }, "is_active": { "type": "boolean" }, "timezone": { "type": ["string", "null"] } } } } } },
      "Password": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["password", "password_confirmation"], "properties": { "password": { "type": "string", "minLength": 8 }, "password_confirmation": { "type": "string" } } } } } }
    },
    "schemas": {
      "Money": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$", "examples": ["125.00"] },
      "Currency": { "type": "string", "enum": ["aed", "usd", "ils"] },
      "Branch": { "type": "string", "enum": ["uae", "gaza"] },
      "CapitalAccountType": { "type": "string", "enum": ["capital", "profit"] },
      "UserRole": { "type": "string", "enum": ["admin", "coordinator", "executor", "transfer_executor"] },
      "TransferCalculation": { "type": "object", "required": ["calculation_mode", "requested_currency", "customer_payable_currency", "commission_amount"], "properties": { "calculation_mode": { "type": "string", "enum": ["receiver_amount", "customer_payment"] }, "requested_amount": { "$ref": "#/components/schemas/Money" }, "requested_currency": { "$ref": "#/components/schemas/Currency" }, "customer_payable_amount": { "$ref": "#/components/schemas/Money" }, "customer_payable_currency": { "$ref": "#/components/schemas/Currency" }, "commission_amount": { "$ref": "#/components/schemas/Money" } } },
      "TransferMutation": { "type": "object", "required": ["receiver_name", "receiver_method", "calculation_mode", "requested_currency", "customer_payable_currency", "commission_amount"], "properties": { "receiver_name": { "type": "string" }, "receiver_method": { "type": "string", "enum": ["bank", "wallet"] }, "receiver_account_number": { "type": ["string", "null"] }, "receiver_wallet_phone": { "type": ["string", "null"] }, "notes": { "type": ["string", "null"] }, "calculation_mode": { "type": "string", "enum": ["receiver_amount", "customer_payment"] }, "requested_amount": { "$ref": "#/components/schemas/Money" }, "requested_currency": { "$ref": "#/components/schemas/Currency" }, "customer_payable_amount": { "$ref": "#/components/schemas/Money" }, "customer_payable_currency": { "$ref": "#/components/schemas/Currency" }, "commission_amount": { "$ref": "#/components/schemas/Money" }, "initial_customer_pay_amount": { "$ref": "#/components/schemas/Money", "description": "Create only." } } },
      "Error": { "type": "object", "properties": { "message": { "type": "string" }, "error": { "type": "object", "properties": { "code": { "type": "string" } } } } },
      "ValidationError": { "type": "object", "properties": { "message": { "type": "string" }, "errors": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } } } },
      "Envelope": { "type": "object", "properties": { "data": {}, "meta": { "type": "object" } } }
    },
    "responses": {
      "Success": { "description": "Successful response in the `data` envelope.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "PaginatedSuccess": { "description": "Paginated `data` with page metadata.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "Error": { "description": "Authentication, authorization, not found, throttling, or domain error.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ValidationError": { "description": "Request validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } }
    }
  }
}
